{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yuejie-travel",
  "main": "dist/deploy/worker-bundled.js",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yuejie-travel-production",
      "database_id": "aebd997a-fc00-42b2-866c-6c1c6172809f"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "yuejie-travel-media"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
